{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^Q-[0-9a-f]{32}$"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "state": {
      "enum": [
        "open",
        "resolved",
        "retired"
      ]
    }
  },
  "required": [
    "id",
    "question",
    "claim_ids",
    "state"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
