{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^Q-[0-9a-f]{32}$"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "state": {
      "enum": [
        "open",
        "resolved",
        "retired"
      ]
    },
    "space": {
      "$ref": "#/$defs/answer_space"
    },
    "focus": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "question",
    "claim_ids",
    "state"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 40
    },
    "answer_space": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "categorical"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 2,
              "uniqueItems": true,
              "maxItems": 1024
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "kind",
            "values"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "numeric"
            },
            "low": {
              "$ref": "#/$defs/decimal"
            },
            "high": {
              "$ref": "#/$defs/decimal"
            },
            "step": {
              "$ref": "#/$defs/decimal"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "kind",
            "low",
            "high",
            "step"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "$comment": "Schema 1.3: optional declared answer space and focus. Legacy records remain valid."
}
