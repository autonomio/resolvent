{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^C-[0-9a-f]{32}$"
    },
    "class": {
      "enum": [
        "observed_fact",
        "derived_inference",
        "assumption",
        "hypothesis",
        "forecast",
        "scenario_variable",
        "decision"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "uncertainty": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "state": {
      "enum": [
        "active",
        "retired"
      ]
    },
    "valid_time": {
      "$ref": "#/$defs/valid_time"
    }
  },
  "required": [
    "id",
    "class",
    "statement",
    "uncertainty",
    "evidence_ids",
    "state"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "time_bound": {
      "type": "object",
      "properties": {
        "precision": {
          "enum": [
            "year",
            "month",
            "day",
            "instant"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "precision",
        "value"
      ],
      "additionalProperties": false
    },
    "time_interval": {
      "type": "object",
      "properties": {
        "start": {
          "anyOf": [
            {
              "$ref": "#/$defs/time_bound"
            },
            {
              "type": "null"
            }
          ]
        },
        "end": {
          "anyOf": [
            {
              "$ref": "#/$defs/time_bound"
            },
            {
              "type": "null"
            }
          ]
        },
        "start_inclusive": {
          "type": "boolean"
        },
        "end_inclusive": {
          "type": "boolean"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "start",
        "end",
        "start_inclusive",
        "end_inclusive",
        "evidence_ids"
      ],
      "additionalProperties": false
    },
    "valid_time": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "specified",
            "unknown",
            "disputed"
          ]
        },
        "intervals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/time_interval"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "status",
        "intervals",
        "notes"
      ],
      "additionalProperties": false
    }
  },
  "$comment": "Schema 1.1: optional, evidence-linked claim valid time. Legacy records remain valid."
}
