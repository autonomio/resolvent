{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^E-[0-9a-f]{32}$"
    },
    "kind": {
      "enum": [
        "external",
        "statement",
        "simulation",
        "derivation",
        "assumption"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "independent": {
      "type": "boolean"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "premise_claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "kind",
    "summary",
    "source_ids",
    "independent",
    "limitations",
    "premise_claim_ids",
    "claim_ids"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
