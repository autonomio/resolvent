{
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^M-[0-9a-f]{32}$"
    },
    "status": {
      "enum": [
        "pending",
        "completed"
      ]
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reviewed_claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "touched_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "deferred": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "no_change_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "trigger": {
      "type": "object",
      "properties": {
        "signal_id": {
          "type": "string",
          "pattern": "^CS-[0-9a-f]{64}$"
        },
        "signal": {
          "$ref": "#/$defs/change_signal"
        }
      },
      "required": [
        "signal_id",
        "signal"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "id",
    "status",
    "base_commit",
    "created_at",
    "claim_ids",
    "reviewed_claim_ids",
    "touched_files",
    "findings",
    "deferred",
    "no_change_reason"
  ],
  "additionalProperties": false,
  "$defs": {
    "change_signal": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "event_type": {
          "enum": [
            "source_available",
            "source_revised",
            "agent_observation",
            "model_changed",
            "manual"
          ]
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt](?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:[Zz]|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "affected_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[CESRQM]-[0-9a-f]{32}$"
          },
          "uniqueItems": true,
          "maxItems": 200
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "uniqueItems": true,
          "maxItems": 16
        },
        "before_revision": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        }
      },
      "required": [
        "schema_version",
        "event_type",
        "origin",
        "reference",
        "revision",
        "observed_at",
        "fingerprint",
        "affected_ids",
        "reason",
        "limitations"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "model_changed"
              }
            }
          },
          "then": {
            "required": [
              "before_revision"
            ],
            "properties": {
              "revision": {
                "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.0"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "trigger"
          ]
        }
      },
      "else": {
        "required": [
          "trigger"
        ]
      }
    }
  ]
}
