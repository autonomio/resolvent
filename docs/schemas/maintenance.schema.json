{
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^M-[0-9a-f]{32}$"
    },
    "status": {
      "enum": [
        "pending",
        "completed"
      ]
    },
    "base_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reviewed_claim_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "touched_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "deferred": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "no_change_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "trigger": {
      "type": "object",
      "properties": {
        "signal_id": {
          "type": "string",
          "pattern": "^CS-[0-9a-f]{64}$"
        },
        "signal": {
          "$ref": "#/$defs/change_signal"
        }
      },
      "required": [
        "signal_id",
        "signal"
      ],
      "additionalProperties": false
    },
    "model_operations": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object"
      }
    },
    "model_base_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "model_decisions_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "subject_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "maxItems": 200
    },
    "window": {
      "type": "object",
      "properties": {
        "start": {
          "enum": [
            "last_completed_recent_workset",
            "hours"
          ]
        },
        "previous_workset_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^M-[0-9a-f]{32}$"
        },
        "from_revision": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "from_committed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "to_committed_at": {
          "type": "string",
          "format": "date-time"
        },
        "hours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8760
        },
        "new_source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^S-[0-9a-f]{32}$"
          },
          "uniqueItems": true
        },
        "question_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^Q-[0-9a-f]{32}$"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "start",
        "previous_workset_id",
        "from_revision",
        "from_committed_at",
        "to_committed_at",
        "hours",
        "new_source_ids",
        "question_ids"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "start": {
                "const": "last_completed_recent_workset"
              }
            }
          },
          "then": {
            "properties": {
              "previous_workset_id": {
                "type": "string"
              },
              "from_revision": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "previous_workset_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "from_revision": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "from_committed_at": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "from_committed_at": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "id",
    "status",
    "base_commit",
    "created_at",
    "claim_ids",
    "reviewed_claim_ids",
    "touched_files",
    "findings",
    "deferred",
    "no_change_reason"
  ],
  "additionalProperties": false,
  "$defs": {
    "change_signal": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "event_type": {
          "enum": [
            "source_available",
            "source_revised",
            "agent_observation",
            "model_changed",
            "manual"
          ]
        },
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt](?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:[Zz]|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "affected_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[CESRQM]-[0-9a-f]{32}$"
          },
          "uniqueItems": true,
          "maxItems": 200
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "uniqueItems": true,
          "maxItems": 16
        },
        "before_revision": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        }
      },
      "required": [
        "schema_version",
        "event_type",
        "origin",
        "reference",
        "revision",
        "observed_at",
        "fingerprint",
        "affected_ids",
        "reason",
        "limitations"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "event_type": {
                "const": "model_changed"
              }
            }
          },
          "then": {
            "required": [
              "before_revision"
            ],
            "properties": {
              "revision": {
                "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.0"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "trigger"
          ]
        }
      },
      "else": {
        "if": {
          "properties": {
            "schema_version": {
              "const": "1.1"
            }
          }
        },
        "then": {
          "required": [
            "trigger"
          ]
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "required": [
              "model_operations"
            ]
          },
          {
            "required": [
              "model_base_sha256"
            ]
          },
          {
            "required": [
              "model_decisions_sha256"
            ]
          }
        ]
      },
      "then": {
        "properties": {
          "schema_version": {
            "enum": [
              "1.2",
              "1.3"
            ]
          }
        },
        "required": [
          "model_operations",
          "model_base_sha256",
          "model_decisions_sha256"
        ]
      }
    },
    {
      "if": {
        "required": [
          "subject_ids"
        ]
      },
      "then": {
        "properties": {
          "schema_version": {
            "const": "1.2"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "window"
        ]
      },
      "then": {
        "properties": {
          "schema_version": {
            "const": "1.3"
          }
        },
        "not": {
          "required": [
            "trigger"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.3"
          }
        }
      },
      "then": {
        "required": [
          "window"
        ]
      }
    }
  ]
}
